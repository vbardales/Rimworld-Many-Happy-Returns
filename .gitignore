# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up back inside,
# since the whole folder is uploaded to the Workshop as-is.
.build/
Source/obj/
Source/bin/

# Development environments
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# System
Thumbs.db
desktop.ini
.DS_Store

# Local agent working files.
.claude/

# DDS copies of the textures, written into the published folder by the game's Workshop upload;
# they are regenerated at every upload, so the PNG stays the only source.
*.dds

# Pickle evidence (reports, logs, captures) stays on disk: too heavy for git, and rewritten by every run.
# A text summary of each run is committed under docs/runs/ instead.
Tests/Pickle/Evidence/

node_modules/
.npm/
