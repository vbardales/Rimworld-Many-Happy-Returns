<Project>

  <PropertyGroup>
    <!--
      Build intermediates go outside the mod folder. RimWorld's Workshop uploader sends the whole
      directory (SteamUGC.SetItemContent on the root, no exclusions possible): leaving obj/ inside
      would publish the publicised reference Assembly-CSharp.dll, and so redistribute Ludeon's own
      code. This has to live in a Directory.Build.props: NuGet restore reads the property before
      the csproj.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\.build\obj\ManyHappyReturns\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\.build\bin\ManyHappyReturns\</BaseOutputPath>
  </PropertyGroup>

</Project>
