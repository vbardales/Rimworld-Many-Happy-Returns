<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>ManyHappyReturns</RootNamespace>
    <AssemblyName>ManyHappyReturns</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\Mod\Assemblies\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No Harmony: the mod patches nothing. The day is detected in a GameComponent, the wishes are
      drawn by the game's own interaction roulette, and everything counted is read back from the
      pawn's memories. Nothing to re-patch at the next update.
    -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
  </ItemGroup>

</Project>
